# URL pública del sitio (todavía no hay dominio definitivo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Sin estas variables la app corre en "modo local" y guarda en .data/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo en el servidor: guarda las cotizaciones del sitio. Nunca la expongas al navegador.
SUPABASE_SECRET_KEY=

# Pruebas: permite el modo local con `next start` (en producción real, déjalo vacío)
# PEEK_ALLOW_LOCAL_MODE=1

# Correo (Resend): invitaciones de clientes y aviso de contrato por firmar.
# Sin esto, el panel muestra la invitación para copiarla y enviarla por WhatsApp.
RESEND_API_KEY=
MAIL_FROM="Peek Media <hola@tu-dominio.com>"

# Solo modo local: clave para firmar la cookie de sesión (si falta, se genera en .data/)
# PEEK_SESSION_SECRET=

# ── Redes sociales (fases 4–7) ──
# Cifrado de tokens: openssl rand -base64 32. Obligatoria en producción; no la cambies después.
TOKEN_ENCRYPTION_KEY=
# Tareas programadas (Vercel Cron manda "Authorization: Bearer CRON_SECRET"): openssl rand -hex 32
CRON_SECRET=

# Meta (Instagram y Facebook). Ver README → Configurar Meta.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# ID del Business Manager de Peek (para el acceso como socio)
META_BUSINESS_ID=
# META_GRAPH_VERSION=v23.0

# Ayrshare (TikTok, YouTube, Google, LinkedIn, Pinterest, X, Threads). Plan Business.
AYRSHARE_API_KEY=
# Para que el cliente conecte solo (JWT). La clave privada con saltos de línea como \n
AYRSHARE_PRIVATE_KEY=
AYRSHARE_DOMAIN=
